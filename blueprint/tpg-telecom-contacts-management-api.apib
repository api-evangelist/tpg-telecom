                  "example": "My list"
                },
                "alias": {
                  "type": "string",
                  "description": "Contact list alias",
                  "example": "List1"
                },
                "nameSet": {
                  "type": "boolean",
                  "writeOnly": true
                },
                "aliasSet": {
