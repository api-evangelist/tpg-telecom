                      },
                      "type": {
                        "type": "string",
                        "description": "Contact channel type",
                        "example": "SMS",
                        "enum": [
                          "SMS",
                          "WHATSAPP"
                        ]
                      },
                      "subscriptionState": {
                        "type": "string",
                        "description": "Subscription state",
                        "example": "UNSUBSCRIBED",
                        "enum": [
                          "SUBSCRIBED",
                          "UNSUBSCRIBED"
                        ]
                      }
                    },
                    "description": "Contact channel update payload"
