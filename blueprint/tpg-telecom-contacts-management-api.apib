                  "type": "string",
                  "description": "Note",
                  "example": "Note"
                },
                "channels": {
                  "type": "array",
                  "description": "Contact channels",
                  "items": {
                    "required": [
                      "channelId",
                      "type"
                    ],
                    "type": "object",
                    "properties": {
                      "channelId": {
                        "type": "string",
                        "description": "Contact channel id (in case phone number - in E164 international format)",
